# Provider: ollama | openai_compat | none
GEMMA_PROVIDER=ollama

# Ollama settings
OLLAMA_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma3:1b

# OpenAI-compatible endpoint (optional / alternative)
OPENAI_COMPAT_URL=
OPENAI_COMPAT_KEY=

# Persistence (MongoDB Atlas free tier, optional - fallback to localStorage + memory if missing)
MONGODB_URI=

# Observability (Sentry DSN, optional)
SENTRY_DSN=

# Port for Fastify server
PORT=3000

# Offline SFX generation tool (development only)
ELEVENLABS_API_KEY=
