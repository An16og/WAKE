{
  "name": "wake-exe",
  "version": "0.1.0",
  "description": "A browser-based ASCII/pixel horror game with an open-weight Gemma model as the ghost in the machine",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "content",
    "client",
    "server",
    "tools"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=content && npm run build --workspace=client && npm run build --workspace=server",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --build --noEmit",
    "eval": "npm run eval --workspace=tools",
    "generate-sfx": "npm run generate-sfx --workspace=tools"
  },
  "dependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.2",
    "@rollup/rollup-linux-x64-gnu": "^4.66.0"
  }
}
